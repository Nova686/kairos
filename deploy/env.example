# Secret de scellement des sessions, au moins 32 caractères (openssl rand -hex 32).
NUXT_APP_SECRET=replace-with-at-least-32-random-characters
# Mot de passe PostgreSQL « kairos » : générez-le avec openssl rand -hex 24 (sans caractère spécial, sûr dans l'URL).
POSTGRES_PASSWORD=replace-with-a-database-password
# Nom de domaine public servi par Caddy, par exemple kairos-moi.duckdns.org.
KAIROS_DOMAIN=kairos-example.duckdns.org
# Sous-domaine DuckDNS seul, sans « .duckdns.org ».
DUCKDNS_SUBDOMAIN=kairos-example
# Jeton de votre compte DuckDNS.
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000
# Identifiant d'application eBay (API Browse).
EBAY_CLIENT_ID=replace-with-ebay-client-id
# Secret d'application eBay.
EBAY_CLIENT_SECRET=replace-with-ebay-client-secret
# Clé d'API pokemontcg.io.
POKEMONTCG_API_KEY=replace-with-pokemontcg-api-key
# Jeton d'API PSA pour la vérification des certificats.
PSA_API_TOKEN=replace-with-psa-api-token
# Reconnaissance par photo : on, ou off sur la machine à 1 Go de mémoire.
NUXT_PHOTO_RECOGNITION=on
