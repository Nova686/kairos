# Secret de scellement des sessions, au moins 32 caractères (openssl rand -hex 32).
NUXT_APP_SECRET=replace-with-at-least-32-random-characters
# Mot de passe PostgreSQL « kairos » : générez-le avec openssl rand -hex 24 (sans caractère spécial, sûr dans l'URL).
POSTGRES_PASSWORD=replace-with-a-database-password
# Nom de domaine public servi par Caddy, par exemple kairos.mon-domaine.fr (ou kairos-moi.duckdns.org avec DuckDNS).
KAIROS_DOMAIN=kairos.example.fr
# Facultatif, seulement sans domaine à vous : sous-domaine DuckDNS seul, sans « .duckdns.org » ; ajoutez alors duckdns à COMPOSE_PROFILES.
DUCKDNS_SUBDOMAIN=
# Facultatif, avec DuckDNS : jeton de votre compte DuckDNS.
DUCKDNS_TOKEN=
# Identifiant d'application eBay (API Browse) ; laissez vide si vous n'avez pas de clé : la source sera désactivée.
EBAY_CLIENT_ID=
# Secret d'application eBay ; laissez vide si vous n'avez pas de clé : la source sera désactivée.
EBAY_CLIENT_SECRET=
# Clé d'API pokemontcg.io ; laissez vide si vous n'avez pas de clé : la source sera désactivée.
POKEMONTCG_API_KEY=
# Jeton d'API PSA pour la vérification des certificats ; laissez vide si vous n'avez pas de clé : la source sera désactivée.
PSA_API_TOKEN=
# Reconnaissance par photo : on, ou off sur la machine à 1 Go de mémoire.
NUXT_PHOTO_RECOGNITION=on
# Services facultatifs, séparés par des virgules : offsite (copie des sauvegardes vers un stockage compatible S3, guide étape 11) et duckdns (nom de domaine gratuit, guide annexe A). Vide = aucun.
COMPOSE_PROFILES=
# Point d'accès S3 donné par votre fournisseur de stockage, par exemple https://s3.<region>.<fournisseur>
KAIROS_OFFSITE_ENDPOINT=
# Région du stockage, telle que la donne votre fournisseur.
KAIROS_OFFSITE_REGION=
# Nom du compartiment (bucket) qui reçoit les copies, par exemple kairos-sauvegardes.
KAIROS_OFFSITE_BUCKET=
# Identifiant de la clé d'accès S3 (« access key »).
KAIROS_OFFSITE_ACCESS_KEY_ID=
# Secret de la clé d'accès S3, souvent affiché une seule fois à sa création.
KAIROS_OFFSITE_SECRET_ACCESS_KEY=
