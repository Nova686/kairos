    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
